{
  "@context": [
    "https://openagrinet.github.io/network-specs/schema/AgricultureResource/v0.1/context.jsonld",
    {
      "@version": 1.1,
      "openagrinet": "https://openagrinet.github.io/network-specs/vocab#",
      "MandiPrice": "openagrinet:MandiPrice",
      "supportedCommodities": {
        "@id": "openagrinet:supportedCommodities",
        "@container": "@set",
        "@context": "https://schema.beckn.io/Descriptor/v2.1/context.jsonld"
      },
      "supportedPriceFields": {
        "@id": "openagrinet:supportedPriceFields",
        "@container": "@set"
      },
      "historicalDataAvailable": "openagrinet:historicalDataAvailable",
      "historyPeriod": "openagrinet:historyPeriod",
      "updateFrequency": "openagrinet:updateFrequency",
      "source": "openagrinet:source",
      "commodityGroup": "openagrinet:commodityGroup",
      "grade": "openagrinet:grade",
      "variety": "openagrinet:variety",
      "market": "openagrinet:market",
      "marketCode": "openagrinet:marketCode",
      "marketName": "openagrinet:marketName",
      "district": "openagrinet:district",
      "state": "openagrinet:state",
      "location": {
        "@id": "openagrinet:location",
        "@context": {
          "geo": {
            "@id": "beckn:geo",
            "@context": "https://schema.beckn.io/GeoJSONGeometry/v2.0/context.jsonld"
          },
          "address": {
            "@id": "beckn:address",
            "@context": "https://schema.beckn.io/Address/v2.0/context.jsonld"
          }
        }
      },
      "arrivalDate": "openagrinet:arrivalDate",
      "prices": "openagrinet:prices",
      "minimum": "openagrinet:minimumPrice",
      "maximum": "openagrinet:maximumPrice",
      "modal": "openagrinet:modalPrice",
      "currency": "openagrinet:currency",
      "unit": "openagrinet:unit",
      "generatedAt": "openagrinet:generatedAt",
      "validity": "openagrinet:validity"
    }
  ]
}
