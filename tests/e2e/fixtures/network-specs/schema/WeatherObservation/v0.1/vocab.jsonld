      "@type": "rdfs:Property",
      "rdfs:label": "update frequency"
    },
    {
      "@id": "openagrinet:geographicGranularities",
      "@type": "rdfs:Property",
      "rdfs:label": "geographic granularities"
    },
    {
      "@id": "openagrinet:observationType",
      "@type": "rdfs:Property",
      "rdfs:label": "observation type"
    },
    {
      "@id": "openagrinet:source",
      "@type": "rdfs:Property",
      "rdfs:label": "source"
    },
    {
      "@id": "openagrinet:location",
      "@type": "rdfs:Property",
      "rdfs:label": "location"
    },
