      "@type": "rdfs:Property",
      "rdfs:label": "supported observation types"
    },
    {
      "@id": "openagrinet:supportedParameters",
      "@type": "rdfs:Property",
      "rdfs:label": "supported parameters"
    },
    {
      "@id": "openagrinet:forecastHorizon",
