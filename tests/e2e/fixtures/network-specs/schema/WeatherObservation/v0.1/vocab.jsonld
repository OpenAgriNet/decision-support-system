      "rdfs:label": "model run at"
    },
    {
      "@id": "openagrinet:validity",
      "@type": "rdfs:Property",
      "rdfs:label": "validity"
    },
    {
      "@id": "openagrinet:parameters",
      "@type": "rdfs:Property",
      "rdfs:label": "parameters"
    },
    {
      "@id": "openagrinet:parameter",
      "@type": "rdfs:Property",
      "rdfs:label": "parameter"
    },
    {
      "@id": "openagrinet:values",
      "@type": "rdfs:Property",
      "rdfs:label": "values",
      "rdfs:comment": "Statistical or instantaneous values reported for one weather parameter under a shared context."
