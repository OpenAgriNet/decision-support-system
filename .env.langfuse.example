# Copy to .env.langfuse and fill in. Generate every CHANGE-ME; do not ship these.

# --- Auto-provision org, project and key pair on first boot -----------------
# Without these, the keys only exist after someone clicks through the UI, and
# the DSS exporter has nothing to authenticate with.
LANGFUSE_INIT_ORG_ID=oan
LANGFUSE_INIT_ORG_NAME=OpenAgriNet
LANGFUSE_INIT_PROJECT_ID=dss
LANGFUSE_INIT_PROJECT_NAME=decision-support-system
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-CHANGE-ME
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-CHANGE-ME
LANGFUSE_INIT_USER_EMAIL=you@example.com
LANGFUSE_INIT_USER_NAME=Your Name
LANGFUSE_INIT_USER_PASSWORD=CHANGE-ME

# --- Secrets ----------------------------------------------------------------
NEXTAUTH_SECRET=CHANGE-ME  # openssl rand -base64 32
SALT=CHANGE-ME  # openssl rand -base64 32
ENCRYPTION_KEY=CHANGE-ME  # openssl rand -hex 32
NEXTAUTH_URL=http://localhost:3000

# --- Backing-service passwords --------------------------------------------
# Hex, not base64. POSTGRES_PASSWORD goes inside DATABASE_URL below, where
# base64's + / = are structural characters and break the URL.
#
#     openssl rand -hex 24
#
POSTGRES_PASSWORD=CHANGE-ME
CLICKHOUSE_PASSWORD=CHANGE-ME
REDIS_AUTH=CHANGE-ME
MINIO_ROOT_PASSWORD=CHANGE-ME

# Two sets of variables in the vendor's compose file do NOT interpolate the
# passwords above — they default to literal values, which is what their
# CHANGEME comments mean. Set a password without also setting these and the
# stack comes up looking healthy while failing in two different ways:
#
#   DATABASE_URL          defaults to ...:postgres@postgres:5432/...
#                         -> langfuse-web crash-loops on Prisma P1000, whose
#                            own hint blames URL-encoding rather than this.
#   LANGFUSE_S3_*_SECRET  default to "miniosecret"
#                         -> spans arrive, then fail to upload with "the
#                            request signature we calculated does not match",
#                            surfacing to the exporter as a 500 and to you as
#                            a trace store that stays empty.
DATABASE_URL=postgresql://postgres:CHANGE-ME@postgres:5432/postgres
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=CHANGE-ME
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=CHANGE-ME
LANGFUSE_S3_BATCH_EXPORT_SECRET_ACCESS_KEY=CHANGE-ME

# --- Langfuse phones home by default. Traces carry farmer content; don't. ---
TELEMETRY_ENABLED=false
