# Read directly by pydantic-ai-slim's AzureProvider, not by DSS Settings.
AZURE_OPENAI_ENDPOINT=replace-me
AZURE_OPENAI_API_KEY=replace-me

# Do NOT set OPENAI_API_VERSION — this endpoint is the v1 GA API, which rejects it.

# Deployment name in Azure, prefixed with azure: so pydantic-ai routes via AzureProvider.
DSS_INTENT_MODEL=azure:gpt-5.6-luna
DSS_MODERATION_MODEL=azure:gpt-5.6-luna

# Optional: self-hosted Langfuse. Leave the endpoint unset to run silently
# offline — `configure_tracing` no-ops, which is the default for a local run
# and every test.
#
# The base, not a full path: the SDK appends `/v1/traces` itself. It must carry
# a scheme — without one the exporter fails once per batch with "No connection
# adapters were found", a message about the URL rather than about the missing
# `http://`. Port 3000 is langfuse-web; 4318 and 4317 are a Collector's, and
# 4317 is its gRPC port besides.
OTEL_EXPORTER_OTLP_ENDPOINT=

# base64 of `<public key>:<secret key>` — the pair `docker-compose.langfuse.yml`
# provisions from LANGFUSE_INIT_PROJECT_*:
#
#     printf '%s:%s' "$PUBLIC_KEY" "$SECRET_KEY" | base64
#
# Two traps, pulling opposite ways. **Quote it**: the value contains a space, so
# an unquoted one makes `set -a; . ./.env` read `Authorization=Basic` as the
# assignment and try to execute the base64 as a command. And leave the `=`
# padding **raw**: the OTel SDK does not percent-decode this variable, so a
# defensive `%3D` arrives verbatim and Langfuse rejects it as `Invalid
# character`.
OTEL_EXPORTER_OTLP_HEADERS="Authorization=Basic replace-me,x-langfuse-ingestion-version=4"

# Pydantic AI counts tokens as metrics, and Langfuse does nothing with them —
# one pointless POST per interval otherwise.
OTEL_METRICS_EXPORTER=none

# Puts the farmer's query and the composed answer in the span verbatim. Only a
# literal "true" opts in. `DSS_ARCHITECTURE.md` §6.1 forbids this in a
# deployment; the process logs a warning at startup when it is on.
DSS_TRACE_INCLUDE_MESSAGE_CONTENT=

# Host port docker-compose publishes the server on.
DSS_HOST_PORT=8077

# For the tier 7 live test (tests/e2e). Only needed if its model id starts with
# `openai:`; an `azure:` id uses the AZURE_OPENAI_* pair above instead.
#
# `OPENAI_BASE_URL`, not `OPENAI_ENDPOINT` — the SDK reads no such name. It is
# the base paths get appended to, so it ends at `/v1`, never at an endpoint
# like `/v1/responses`.
#
# Setting them *here* only reaches the container: docker-compose interpolates
# this file into `environment:`. A local `uv run pytest` does not — pydantic-
# settings reads `.env` into `Settings`, never into `os.environ`, and both the
# SDK and the test's own skip guard read `os.environ`. So for a local run,
# export them (`set -a; source .env; set +a`) — see docs/RUNNING.md.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# --- model gateway (ADR-0013) -----------------------------------------------
# Every model call goes through the gateway. See docs/RUNNING-GATEWAY.md.

# The gateway's own admin credential. The DSS never uses it — it holds a virtual
# key issued by the gateway instead. Generate one: openssl rand -hex 24
LITELLM_MASTER_KEY=

# Encrypts vendor keys in the gateway's database. Generate: openssl rand -hex 32
#
# Set it ONCE, before the gateway stores anything, and never change it. Rotating
# it does not fail loudly: everything saved earlier becomes unreadable, the
# gateway sends nonsense to the vendor, and the vendor replies that the key is
# invalid. Losing it means re-entering every vendor key.
LITELLM_SALT_KEY=

# The gateway's port on the host. 4000 is its default and is often already taken.
LITELLM_HOST_PORT=4100

# Basic auth for the collector's export to Langfuse:
#   printf '<public-key>:<secret-key>' | base64
LANGFUSE_OTEL_AUTH=
