# Read directly by pydantic-ai-slim's AzureProvider, not by DSS Settings.
AZURE_OPENAI_ENDPOINT=replace-me
AZURE_OPENAI_API_KEY=replace-me

# Do NOT set OPENAI_API_VERSION — this endpoint is the v1 GA API, which rejects it.

# Deployment name in Azure, prefixed with azure: so pydantic-ai routes via AzureProvider.
DSS_INTENT_MODEL=azure:gpt-5.6-luna
DSS_MODERATION_MODEL=azure:gpt-5.6-luna

# Optional: self-hosted Langfuse OTEL endpoint. Leave unset to run silently offline.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Host port docker-compose publishes the server on.
DSS_HOST_PORT=8077

# For the tier 7 live test (tests/e2e). Only needed if its model id starts with
# `openai:`; an `azure:` id uses the AZURE_OPENAI_* pair above instead.
#
# `OPENAI_BASE_URL`, not `OPENAI_ENDPOINT` — the SDK reads no such name. It is
# the base paths get appended to, so it ends at `/v1`, never at an endpoint
# like `/v1/responses`.
#
# Setting them *here* only reaches the container: docker-compose interpolates
# this file into `environment:`. A local `uv run pytest` does not — pydantic-
# settings reads `.env` into `Settings`, never into `os.environ`, and both the
# SDK and the test's own skip guard read `os.environ`. So for a local run,
# export them (`set -a; source .env; set +a`) — see docs/RUNNING.md.
OPENAI_API_KEY=
OPENAI_BASE_URL=
