      "width": 698.32,
      "height": 17.5,
      "strokeColor": "#868e96",
      "text": "Proposed: the DSS reads the provider's own API contract, not a field list in the pack.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Proposed: the DSS reads the provider's own API contract, not a field list in the pack.",
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
