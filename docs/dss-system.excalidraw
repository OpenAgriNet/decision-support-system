      "strokeColor": "#868e96",
      "text": "Schema packs come from network-specs. A pack is used three ways:",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Schema packs come from network-specs. A pack is used three ways:",
