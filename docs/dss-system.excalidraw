      "width": 893.2,
      "height": 17.5,
      "strokeColor": "#868e96",
      "text": "The contract carries enough metadata and description for the planner model to tell which API to call, and how.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The contract carries enough metadata and description for the planner model to tell which API to call, and how.",
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
