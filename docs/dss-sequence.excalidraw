      "backgroundColor": "transparent",
      "seed": 8749,
      "text": "Moderation is started before the planner and awaited after it. Planning and moderation overlap.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Moderation is started before the planner and awaited after it. Planning and moderation overlap.",
