      "backgroundColor": "transparent",
      "seed": 8756,
      "text": "Provider Discovery is read-only, so it may cross the barrier. A Provider call cannot be taken back.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Provider Discovery is read-only, so it may cross the barrier. A Provider call cannot be taken back.",
